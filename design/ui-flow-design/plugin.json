{
  "name": "ui-flow-design",
  "version": "1.1.0",
  "description": "機能要件から画面構成・ワイヤーフレームまでを2ステップで落とし込むスキル。ワイヤーフレームファーストで、Salt ワイヤーフレームを見ながらユーザーと一緒に画面設計を詰めていく",
  "author": { "name": "sunagaku" },
  "license": "MIT",
  "keywords": ["ui-design", "wireframe", "plantuml", "salt", "screen-flow", "ui-flow"],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/plugins/cache/sunagaku-marketplace/ui-flow-design/1.1.0/hooks/validate-puml/hook.sh\""
          }
        ]
      }
    ]
  }
}
